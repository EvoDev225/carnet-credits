# Copie ce fichier en .env puis remplace les valeurs. Ne commite jamais .env.

# Port HTTP de l'API
PORT=3000

# development | production | test
NODE_ENV=development

# MongoDB en replica set (obligatoire : les soldes utilisent des transactions).
# Local : voir README, section « MongoDB en replica set ». Production : MongoDB Atlas.
MONGO_URI=mongodb://127.0.0.1:27017/carnet-credits?replicaSet=rs0

# Au moins 32 caractères aléatoires. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=remplace-moi-par-une-valeur-aleatoire-de-48-octets

# Durée de validité des sessions : 7d, 12h, 30m ou un nombre de secondes
JWT_EXPIRES_IN=7d

# Derrière un hébergeur / reverse proxy, mettre le nombre de proxys (souvent 1).
# false en local. Indispensable pour que la limitation de débit voie la vraie IP.
TRUST_PROXY=false

# Origines web autorisées (CORS), séparées par des virgules. L'app native n'en a pas besoin.
# Vide en développement = http://localhost:8081 (Expo web) autorisé.
CORS_ORIGINS=

# Indicatif pays par défaut pour les numéros saisis sans indicatif (225 = Côte d'Ivoire)
DEFAULT_COUNTRY_CODE=225

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Requêtes max par IP et par 15 minutes sur l'ensemble de l'API
RATE_LIMIT_MAX=300
